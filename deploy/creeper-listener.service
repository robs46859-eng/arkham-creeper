[Unit]
Description=Arkham Creeper passive webhook listener
After=network-online.target
Wants=network-online.target

[Service]
User=creeper
Group=creeper
WorkingDirectory=/opt/arkham-creeper
EnvironmentFile=/etc/arkham-creeper/environment
StateDirectory=arkham-creeper
StateDirectoryMode=0700
UMask=0077
ExecStart=/opt/arkham-creeper/.venv/bin/python -m creeper listen --state /var/lib/arkham-creeper --port 8787
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
